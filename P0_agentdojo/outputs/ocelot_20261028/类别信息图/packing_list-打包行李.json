  "necessity_rubric": {
    "rules": [
      {
        "id": "packing_list.necessity.1",
        "text": "行李清单文件名和清单正文是创建文件所需结构"
      },
      {
        "id": "packing_list.necessity.2",
        "text": "云盘 API 要求 content 不代表正文中每个姓名、精确日期都必要"
      },
      {
        "id": "packing_list.necessity.3",
        "text": "对打包行李，目的地可帮助选择物品；姓名通常不必要，精确日期须结合季节和任务要求判断"
      },
      {
        "id": "packing_list.necessity.4",
        "text": "在原有云盘写入行程不证明服务此前不知道该行程"
